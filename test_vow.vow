# VOW (Voided Our Warranty) - Consolidated Test File
# Tests brace syntax - .vow files automatically start in brace mode!

# ============================================================
# PART 1: Brace Syntax (automatic for .vow files!)
# ============================================================

# No #;braces needed - .vow files start in brace mode

proc testBraceIf(name: string) = {
  if name == "" {
    echo("Hello, stranger!")
  } else {
    echo("Hello, " & name)
  }
}

proc testBraceWhile() = {
  var i = 0
  while i < 3 {
    echo("while i = " & $i)
    i = i + 1
  }
}

proc testBraceFor() = {
  for i in 0..2 {
    echo("for i = " & $i)
  }
}

# For loop with complex range expression
proc testBraceForComplex() = {
  let a = 5
  let b = 3
  for i in 0 ..< min(a, b) {
    echo("complex for i = " & $i)
  }
}

proc testBraceNested() = {
  if true {
    if true {
      echo("deeply nested braces")
    }
  }
}

# Test addr with function call syntax (addr(x) not addr x)
proc takesPtr(p: ptr int) = {
  echo("addr test: ", p[])
}

proc testBraceAddr() = {
  var x = 99
  takesPtr(addr(x))
}

proc testSetLiteral() = {
  # Set literals still work in brace mode
  let s = {1, 2, 3}
  echo("set: ", s)
}

proc testOptionalColon() = {
  # Both styles work
  if true {
    echo("no colon before brace")
  }
  if true: {
    echo("with colon before brace")
  }
}

# Type definitions with braces
type Person = object {
  name: string
  age: int
}

proc testBraceType() = {
  var p = Person(name: "Alice", age: 30)
  echo("brace type: ", p.name, " is ", p.age)
}

# Enum with braces
type Color = enum { Red, Green, Blue }

proc testBraceEnum() = {
  var c = Green
  echo("brace enum: ", c)
}

# Tuple with braces
type Point = tuple { x: int; y: int }

proc testBraceTuple() = {
  var pt: Point = (x: 10, y: 20)
  echo("brace tuple: ", pt.x, ", ", pt.y)
}

# Case statement with braces around body
proc testBraceCase(n: int) = {
  case n {
    of 1 { echo("case: one") }
    of 2 { echo("case: two") }
    else { echo("case: other") }
  }
}

# Inline case statement (no braces around case body, just around proc body)
proc testInlineCaseElse(d: int): string = {
  case d of 2: return "down" of 4: return "left" of 6: return "right" of 8: return "up" else: return "none"
}

# Inline case with single of and else on same line
proc testInlineCaseSimple(n: int): string = {
  case n of 1: return "one" else: return "other"
}

# Object variant with braces
type NodeKind = enum { nkInt, nkStr }
type Node = object {
  case kind: NodeKind {
    of nkInt { intVal: int }
    of nkStr { strVal: string }
  }
}

proc testBraceVariant() = {
  var n1 = Node(kind: nkInt, intVal: 42)
  var n2 = Node(kind: nkStr, strVal: "hello")
  echo("variant int: ", n1.intVal)
  echo("variant str: ", n2.strVal)
}

# Test mode switching (can still use #;indent to switch to indent mode)
#;indent

proc testIndentMode() =
  # Back to indent mode
  if true:
    echo "indent mode works"
  for i in 0..1:
    echo "indent loop: " & $i

#;braces

proc testBracesAgain() = {
  echo("can switch back to braces")
}

# Statement-separating semicolons in brace mode
proc testSemicolons() = {
  var a = 1; var b = 2; var c = 3
  echo("semicolons: a=", a, " b=", b, " c=", c)
  a = 10; b = 20
  echo("semicolons reassign: a=", a, " b=", b)
  # Trailing semicolons (should be harmless)
  var d = 4;
  echo("trailing semicolon: d=", d)
  # Multiple semicolons between statements
  var e = 5;; var f = 6
  echo("double semicolon: e=", e, " f=", f)
  # Semicolons with control flow on one line
  if a == 10 { b = 99 }; echo("after if-semicolon: b=", b)
}

# Pragmas in brace mode — {. .} must not be confused with block {
{.push warning[UnusedImport]: off.}
{.pop.}

proc testPragmaInline(): int {.inline.} = {
  result = 42
}

proc testPragmaNoSideEffect(x: int): int {.noSideEffect.} = {
  result = x * 2
}

proc testPragmas() = {
  echo("pragma inline: ", testPragmaInline())
  echo("pragma noSideEffect: ", testPragmaNoSideEffect(21))
}

# ============================================================
# Command syntax & optional-operand statements (brace mode)
# ============================================================

# Statement-level command syntax: a bare `callee arg` with the argument on the
# SAME line as the callee (a newline terminates the statement, C/JS-style).
proc cmdShow(a: int) = { echo("cmdShow: ", a) }
proc cmdShow2(a: int, b: string) = { echo("cmdShow2: ", a, " ", b) }

proc testStatementCommand() = {
  cmdShow 7
  cmdShow2 3, "three"
  echo "bare echo"
  # two commands on separate lines stay separate (newline is the boundary):
  cmdShow 1
  cmdShow 2
  # a same-line `{` opens a block, not a command argument, so a set literal
  # passed to a command needs parens:
  echo("set arg: ", {1, 2})
}

# Expression-context command syntax: `addr x[i]` without parens.
proc testAddrCommand() = {
  var arr = @[10, 20, 30]
  var p = addr arr[1]
  p[] = p[] + 5
  echo("addr command: ", arr[1])
}

# Optional-operand statements: the operand must be on the keyword's own line; a
# bare `return`/`break`/`continue` does not swallow the next line's statement.
proc earlyReturn(x: int): int = {
  if x < 0 {
    return
  }
  result = x * 2
}

proc loopBreakContinue(): int = {
  var total = 0
  for i in 0..5 {
    if i == 2 {
      continue
    }
    if i == 4 {
      break
    }
    total = total + i
  }
  result = total
}

proc testOptionalOperand() = {
  echo("early return neg: ", earlyReturn(-1))
  echo("early return pos: ", earlyReturn(5))
  echo("break/continue: ", loopBreakContinue())
}

# Anonymous (unlabeled) block in brace mode: `block { ... }`.
proc testAnonBlock() = {
  var hit = 0
  block {
    hit = 7
  }
  echo("anon block: ", hit)
}

# Inline `enum a, b` (no braces) must terminate at the newline and NOT swallow the
# following top-level statement. `inlineSentinel` right below proves it.
type InlineEnum = enum iea, ieb, iec
var inlineSentinel = 42

proc testInlineEnum() = {
  echo("inline enum: ord(iec)=", ord(iec), " sentinel=", inlineSentinel)
}

# ============================================================
# PART 2: Alias Tests (in brace mode)
# ============================================================

# Original proc to be aliased
proc greet(name: string) = {
  echo("Original: Hello, " & name)
}

# First alias - wrap the original
#;alias(greetOriginal)
proc greet(name: string) = {
  echo("[before greet]")
  greetOriginal(name)
  echo("[after greet]")
}

# Test chained aliasing
#;alias(greetV1)
proc greet(name: string) = {
  echo("=== START ===")
  greetV1(name)
  echo("=== END ===")
}

proc testAlias() = {
  echo("Testing alias in brace mode:")
  greet("World")
  echo("")
  echo("Calling intermediate alias directly:")
  greetV1("Direct")
  echo("")
  echo("Calling original alias directly:")
  greetOriginal("Original")
}

# Test alias with return value
proc double(x: int): int = {
  result = x * 2
}

#;alias(doubleOriginal)
proc double(x: int): int = {
  result = doubleOriginal(x) + 10
}

# Test alias with multiple params
proc add(a, b: int): int = {
  result = a + b
}

#;alias(addOriginal)
proc add(a, b: int): int = {
  echo("adding ", a, " + ", b)
  result = addOriginal(a, b)
}

proc testAliasReturnValue() = {
  echo("double(5) = ", double(5))  # Should be 5*2 + 10 = 20
  echo("add(3, 4) = ", add(3, 4))  # Should print "adding..." and return 7
}

# Test single-line proc alias
proc triple(x: int): int = { result = x * 3 }

#;alias(tripleOriginal)
proc triple(x: int): int = { result = tripleOriginal(x) + 100 }

proc testSingleLineAlias() = {
  echo("triple(5) = ", triple(5))  # Should be 5*3 + 100 = 115
}

# Test alias with comment between directive and proc
proc quadruple(x: int): int = {
  result = x * 4
}

#;alias(quadrupleOriginal)
# This is a comment between the alias directive and the proc
proc quadruple(x: int): int = {
  result = quadrupleOriginal(x) + 1000
}

proc testAliasWithComment() = {
  echo("quadruple(5) = ", quadruple(5))  # Should be 5*4 + 1000 = 1020
}

# Test alias with control flow in body
proc checkValue(x: int): string = {
  if x < 0 {
    return "negative"
  } elif x == 0 {
    return "zero"
  } else {
    return "positive"
  }
}

#;alias(checkValueOriginal)
proc checkValue(x: int): string = {
  echo("checking: ", x)
  result = checkValueOriginal(x)
  echo("result was: ", result)
}

proc testAliasControlFlow() = {
  echo("checkValue(-5) = ", checkValue(-5))
  echo("checkValue(0) = ", checkValue(0))
  echo("checkValue(10) = ", checkValue(10))
}

# Test: code immediately after alias without blank line
proc compute(x: int): int = {
  result = x + 1
}
#;alias(computeOriginal)
proc compute(x: int): int = {
  result = computeOriginal(x) * 2
}
var computeTestVar = 42  # var immediately after aliased proc

proc testAliasNoBlankLine() = {
  echo("compute(5) = ", compute(5))  # Should be (5+1)*2 = 12
  echo("computeTestVar = ", computeTestVar)
}

# Test rapid chaining - 3 aliases in a row with no blank lines
proc rapidChain(x: int): int = { result = x }
#;alias(rapidV0)
proc rapidChain(x: int): int = { result = rapidV0(x) + 1 }
#;alias(rapidV1)
proc rapidChain(x: int): int = { result = rapidV1(x) + 10 }
#;alias(rapidV2)
proc rapidChain(x: int): int = { result = rapidV2(x) + 100 }

proc testRapidChain() = {
  echo("rapidChain(5) = ", rapidChain(5))  # Should be 5+1+10+100 = 116
  echo("rapidV2(5) = ", rapidV2(5))  # Should be 5+1+10 = 16
  echo("rapidV1(5) = ", rapidV1(5))  # Should be 5+1 = 6
  echo("rapidV0(5) = ", rapidV0(5))  # Should be 5
}

# ============================================================
# PART 2b: Alias ARC Scope Test (cross-file)
# ============================================================
# Regression test for use-after-free bug: the nkAliasDef sem handler
# was missing pushOwner, so locals inside cross-file alias bodies
# got sfGlobal (module scope). Template gensyms (e.g., orTmp from `or`)
# became C globals — eqdestroy without eqwasMoved left dangling pointers.
#
# NOTE: Same-file aliases are handled by the parser-level transform
# (transformAliasProcs) which converts them to regular nkProcDef nodes.
# Only cross-file aliases (where the original is in an included file)
# reach the sem-level nkAliasDef handler where the bug existed.
#
# The full cross-file test is in test_vow_arc_main.vow (includes
# test_vow_arc_original.vow + test_vow_arc_alias.vow).
# Here we just include them to run as part of the main test suite.

include "test_vow_arc_original.vow"
include "test_vow_arc_alias.vow"

proc testAliasArcScope() = {
  echo("Testing alias ARC scope (cross-file use-after-free regression):")
  for i in 1..50 {
    let val = makeArcObj(float(i * 10))
    let def = makeArcObj(999.0)
    let r = arcProcessValue(val, def)
    if int(r) != i * 10 {
      echo("FAIL at i=", i, ": expected ", i*10, " got ", int(r))
      quit(1)
    }
  }
  echo("  PASS: 50 calls to cross-file aliased proc survived")

  for i in 0..20 {
    let val = if i mod 3 == 0: makeArcObj(0.0) else: makeArcObj(float(i * 10))
    let def = makeArcObj(777.0)
    let r = arcProcessValue(val, def)
    let expected = if i mod 3 == 0: 777.0 else: float(i * 10)
    if r != expected {
      echo("FAIL at i=", i, ": expected ", expected, " got ", r)
      quit(1)
    }
  }
  echo("  PASS: 21 mixed truthy/falsy calls survived")
}

# ============================================================
# PART 3: Run All Tests
# ============================================================

echo("--- Brace Syntax Tests ---")
testBraceIf("World")
testBraceIf("")
testBraceWhile()
testBraceFor()
testBraceForComplex()
testBraceNested()
testBraceAddr()
testSetLiteral()
testOptionalColon()
testBraceType()
testBraceEnum()
testBraceTuple()
testBraceCase(1)
testBraceCase(2)
testBraceCase(99)
echo("inline case else: ", testInlineCaseElse(2))
echo("inline case else: ", testInlineCaseElse(8))
echo("inline case else: ", testInlineCaseElse(99))
echo("inline case simple: ", testInlineCaseSimple(1))
echo("inline case simple: ", testInlineCaseSimple(5))
testBraceVariant()
testIndentMode()
testBracesAgain()
testSemicolons()
testPragmas()
testStatementCommand()
testAddrCommand()
testOptionalOperand()
testAnonBlock()
testInlineEnum()

echo("")
echo("--- Alias Tests ---")
testAlias()
echo("")
testAliasReturnValue()
testSingleLineAlias()
testAliasWithComment()
testAliasControlFlow()
testAliasNoBlankLine()
testRapidChain()

echo("")
echo("--- Alias ARC Scope Tests ---")
testAliasArcScope()

echo("")
echo("--- All VOW tests complete! ---")
